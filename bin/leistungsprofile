#!/bin/bash
set -eu
current=$(cat /sys/firmware/acpi/platform_profile)
if [ "$current" = performance ] && [ "$(cat /sys/class/powercap/intel-rapl-mmio:0/constraint_0_power_limit_uw)" = 24000000 ]; then
    current=boost
fi
case "$current" in
    boost) current_label='Mehr Leistung (24 W)' ;;
    performance) current_label='Performance' ;;
    balanced) current_label='Balance' ;;
    low-power) current_label='Battery Save' ;;
    *) current_label="$current" ;;
esac
selected=$(zenity --list --radiolist \
    --title='ThinkPad Leistungsprofile' \
    --text="Aktuell: $current_label\n\nWähle ein Leistungsprofil. Ein Wechsel benötigt dein Administratorpasswort." \
    --width=680 --height=490 \
    --column='' --column='Profil' --column='Beschreibung' --column='Wert' \
    --hide-column=4 --print-column=4 \
    "$([ "$current" = performance ] && echo TRUE || echo FALSE)" 'Performance' 'Mehr Leistung; höhere Lüfterlautstärke und Verbrauch' performance \
    "$([ "$current" = boost ] && echo TRUE || echo FALSE)" 'Mehr Leistung (24 W)' 'Für Spiele am Netzteil; unter 28 W wegen der gemessenen Wärmegrenze' boost \
    "$([ "$current" = balanced ] && echo TRUE || echo FALSE)" 'Balance' 'Ausgewogen für den Alltag' balanced \
    "$([ "$current" = low-power ] && echo TRUE || echo FALSE)" 'Battery Save' 'Weniger Verbrauch und Leistung; für längere Akkulaufzeit' low-power \
    --ok-label='Anwenden' --cancel-label='Schließen') || exit 0
[ -n "$selected" ] || exit 0
case "$selected" in
    boost) label='Mehr Leistung (24 W)' ;;
    performance) label='Performance' ;;
    balanced) label='Balance' ;;
    low-power) label='Battery Save' ;;
    *) exit 2 ;;
esac
if result=$(pkexec /usr/local/libexec/thinkpad-power-profile "$selected" 2>&1); then
    notify-send --app-name='Leistungsprofile' --icon=preferences-system-power 'Leistungsprofil geändert' "$label ist aktiv."
else
    zenity --error --title='Leistungsprofil nicht geändert' --text="Der Wechsel wurde abgebrochen oder ist fehlgeschlagen.\n$result"
    exit 1
fi
